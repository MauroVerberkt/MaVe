<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>MaVe.BusinessRules</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>BusinessRules Management Framework</Title>
    <Description>A code generation-based framework for defining, managing, and enforcing business rules with Source Generators and Roslyn Analyzers</Description>
    <PackageTags>businessrules;validation;sourcegenerator;analyzer;codegen</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath=""/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MaVe.BusinessRules.Wcf"/>
    <InternalsVisibleTo Include="MaVe.BusinessRules.Wcf.UnitTests"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessRulesAnalyzer\BusinessRulesAnalyzer.csproj"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\BusinessRulesFixProvider\BusinessRulesFixProvider.csproj"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\BusinessRulesGenerator\BusinessRulesGenerator.csproj"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\BusinessRulesAnalyzer\bin\$(Configuration)\netstandard2.0\MaVe.BusinessRulesAnalyzer.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    <None Include="..\BusinessRulesFixProvider\bin\$(Configuration)\netstandard2.0\MaVe.BusinessRulesFixProvider.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    <None Include="..\BusinessRulesGenerator\bin\$(Configuration)\netstandard2.0\MaVe.BusinessRulesGenerator.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="schemas\businessrules-schema.json" Pack="true" PackagePath="schemas\"/>
    <None Include="packaging/MaVe.BusinessRules.props" Pack="true" PackagePath="build/$(PackageId).props"/>
  </ItemGroup>

</Project>
